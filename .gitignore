# Track ONLY the docs (*.md) and startup shells (*.sh), plus the small patch
# files those shells mount/depend on. Ignore everything else: GPU/JIT caches,
# cloned upstream repos, benchmark result JSON, and logs.

# 1) ignore everything by default
*

# 2) re-include docs and startup/launch shells
!*.md
!*.sh

# 2b) re-include the overnight grid-search harness (a reusable tool, not an artifact)
!grid_search.py
# 2c) losslessness capture/compare harness (see BENCHMARKS.md Phase 14 §2 -- the
#     byte-comparison it performs is invalid on this stack today, but the harness
#     is kept for if/when batch-invariant kernels make it meaningful)
!spec-extend-lossless-check.py
# 2d) bench contamination filter: llm-inference-bench does NOT detect external
#     traffic during a decode cell (it only flags UNDER-filled cells), so on a
#     live box a cell someone else's request landed in is silently wrong. This
#     applies the missing rule. See BENCHMARKS.md Phase 18 s9.
!agg-clean-cells.py

# 3) re-include launcher dependency dirs + the files they need
#    (tool-call parser patch, and the LMCache mount scripts/patches)
!patch/
!patch/*.py
# v14 image launcher w/ allreduce override (no .sh ext) + vendored LMCache patch set
!patch/run-glm52-v14-server
!patch/lmcache-v14/
!patch/lmcache-v14/*.py
!lmcache-mnt/
!lmcache-mnt/*.py

# 4) never descend into caches / clones / refs / result artifacts
cache/
cache-v11/
lmcache_l2/
rtx6kpro/
glm-5.2-v11-lmcache/
image-ref/
*.json
*.log
